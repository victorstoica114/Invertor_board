#!/bin/sh

# Keep the Synology OpenVPN profile healthy and bind it to the best available
# physical uplink. This script is called by a systemd timer and by the
# NetworkManager dispatcher; flock prevents overlapping activation attempts.

set -u

VPN_UUID="caa7840e-6747-4c24-a049-86fe74d6f039"
VPN_NAME="Synology OpenVPN"
VPN_REMOTE_HOST="victorstoica114.synology.me"
VPN_HEALTH_TARGET="192.168.123.1"
LOCK_FILE="/run/uwb-openvpn-watchdog/lock"

NMCLI="/usr/bin/nmcli"
IP="/usr/sbin/ip"
PING="/usr/bin/ping"
SYSCTL="/usr/sbin/sysctl"
LOGGER="/usr/bin/logger"

exec 9>"$LOCK_FILE"
/usr/bin/flock -n 9 || exit 0

log() {
    "$LOGGER" -t uwb-openvpn-watchdog "$*"
}

force_ipv4_only() {
    "$SYSCTL" -q -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
    "$SYSCTL" -q -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true

    for ipv6_interface in wlan0 eth0 /sys/class/net/tun*; do
        ipv6_interface="${ipv6_interface##*/}"
        [ -e "/proc/sys/net/ipv6/conf/$ipv6_interface/disable_ipv6" ] || continue
        "$SYSCTL" -q -w "net.ipv6.conf.$ipv6_interface.disable_ipv6=1" >/dev/null 2>&1 || true
    done
}

device_connected() {
    [ "$("$NMCLI" -g GENERAL.STATE device show "$1" 2>/dev/null | /usr/bin/cut -d' ' -f1)" = "100" ]
}

has_ipv4_default_route() {
    "$IP" -4 route show default dev "$1" 2>/dev/null | /usr/bin/grep -q .
}

uplink_available() {
    device_connected "$1" && has_ipv4_default_route "$1"
}

remote_ipv4() {
    /usr/bin/getent ahostsv4 "$VPN_REMOTE_HOST" 2>/dev/null |
        /usr/bin/awk 'NR == 1 { print $1; exit }'
}

uplink_reaches_server() {
    probe_interface="$1"
    probe_address="$2"

    [ -n "$probe_address" ] || return 1
    "$PING" -4 -I "$probe_interface" -c 1 -W 2 "$probe_address" >/dev/null 2>&1
}

select_uplink() {
    address="$(remote_ipv4)"

    # Prefer Ethernet only when it can reach the VPN server. A cabled LAN with
    # DHCP but no internet must not displace a working Wi-Fi connection.
    if uplink_available eth0 && uplink_reaches_server eth0 "$address"; then
        echo eth0
        return 0
    fi
    if uplink_available wlan0 && uplink_reaches_server wlan0 "$address"; then
        echo wlan0
        return 0
    fi

    # ICMP may be filtered. Retain deterministic Ethernet-first fallback and
    # let the real OpenVPN activation decide whether the server is reachable.
    if uplink_available eth0; then
        echo eth0
        return 0
    fi
    if uplink_available wlan0; then
        echo wlan0
        return 0
    fi

    return 1
}

vpn_parent() {
    "$NMCLI" -t -f UUID,TYPE,DEVICE connection show --active 2>/dev/null |
        /usr/bin/awk -F: -v uuid="$VPN_UUID" '$1 == uuid && $2 == "vpn" { print $3; exit }'
}

vpn_tunnel() {
    "$IP" -4 route get "$VPN_HEALTH_TARGET" 2>/dev/null |
        /usr/bin/awk '{ for (field = 1; field <= NF; field++) if ($field == "dev") { print $(field + 1); exit } }'
}

vpn_is_healthy() {
    health_tunnel="$(vpn_tunnel)"

    [ -n "$(vpn_parent)" ] || return 1
    case "$health_tunnel" in
        tun*) ;;
        *) return 1 ;;
    esac
    "$IP" -4 address show dev "$health_tunnel" 2>/dev/null | /usr/bin/grep -q 'inet ' || return 1
    "$PING" -4 -I "$health_tunnel" -c 1 -W 3 "$VPN_HEALTH_TARGET" >/dev/null 2>&1
}

wait_for_healthy_vpn() {
    attempt=1
    while [ "$attempt" -le 5 ]; do
        force_ipv4_only
        if vpn_is_healthy; then
            return 0
        fi
        /usr/bin/sleep 2
        attempt=$((attempt + 1))
    done
    return 1
}

stop_vpn() {
    "$NMCLI" -w 10 connection down uuid "$VPN_UUID" >/dev/null 2>&1 || true
}

start_vpn() {
    start_interface="$1"

    if "$NMCLI" -w 30 connection up uuid "$VPN_UUID" ifname "$start_interface" >/dev/null 2>&1 &&
        wait_for_healthy_vpn; then
        log "$VPN_NAME is healthy through $start_interface"
        return 0
    fi

    log "$VPN_NAME activation through $start_interface failed; retrying on the next watchdog run"
    stop_vpn
    return 1
}

force_ipv4_only

preferred="$(select_uplink)" || {
    log "No usable IPv4 uplink is available"
    exit 0
}

current="$(vpn_parent)"
if vpn_is_healthy && [ "$current" = "$preferred" ]; then
    exit 0
fi

if [ -n "$current" ]; then
    if vpn_is_healthy; then
        log "Switching $VPN_NAME from $current to preferred uplink $preferred"
    else
        log "$VPN_NAME is present but unhealthy; reconnecting through $preferred"
    fi
    stop_vpn
    /usr/bin/sleep 2
else
    log "$VPN_NAME is down; connecting through $preferred"
fi

start_vpn "$preferred" || true
exit 0
