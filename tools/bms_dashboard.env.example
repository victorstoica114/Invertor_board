# Bluetooth BMS dashboard network and polling settings.
BMS_DASHBOARD_HOST=0.0.0.0
BMS_DASHBOARD_PORT=8765
BMS_DASHBOARD_POLL_INTERVAL=20
BMS_DASHBOARD_PROTOCOL_INTERVAL=300

# Inverter telemetry is read from the SQLite database maintained by
# inverter-telemetry.service. A sample is considered stale after 90 seconds.
BMS_DASHBOARD_TELEMETRY_DATABASE=/home/pi/Documents/Inverter_Board/data/telemetry.sqlite3
BMS_DASHBOARD_INVERTER_STALE_SECONDS=90

# Smart-device credentials live outside the repository and must use mode 0600.
BMS_DASHBOARD_IOT_POLL_INTERVAL=10
BMS_DASHBOARD_PLUG_INVENTORY=/home/pi/.config/iot-keys/xiaomi_plugs.json
BMS_DASHBOARD_AC_CONFIGURATION=/home/pi/.config/iot-keys/tuya_ac.json

# The dashboard trusts its local LAN/VPN and does not use an additional
# application password. Restrict port 8765 at the network boundary.
