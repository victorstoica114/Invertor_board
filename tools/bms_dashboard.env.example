# Bluetooth BMS dashboard network and polling settings.
BMS_DASHBOARD_HOST=0.0.0.0
BMS_DASHBOARD_PORT=8765
BMS_DASHBOARD_POLL_INTERVAL=20
BMS_DASHBOARD_PROTOCOL_INTERVAL=300

# Leave empty for a read-only dashboard. Set a private random value to enable
# JK and Seplos protocol changes, and never commit the populated environment file.
BMS_DASHBOARD_CONTROL_TOKEN=
