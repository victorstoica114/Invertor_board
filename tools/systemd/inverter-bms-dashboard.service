[Unit]
Description=BMS and Wi-Fi inverter monitoring and control dashboard
After=network-online.target bluetooth.target dbus.service
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=bluetooth
WorkingDirectory=/home/pi/Documents/Inverter_Board
EnvironmentFile=-/home/pi/.config/inverter-bms-dashboard.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/pi
ExecStart=/home/pi/.venvs/inverter-bms-dashboard/bin/python /home/pi/Documents/Inverter_Board/tools/bms_dashboard.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=inverter-bms-dashboard
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/run/user/1000

[Install]
WantedBy=multi-user.target
